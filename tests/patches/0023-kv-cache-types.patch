 // Test cases for evaluation: should try to cover edge cases while using small input sizes to keep the runtime low
+// Explicit matrix for flat cache formats, selectable with -p kv_types.
+struct test_fa_kv_types : test_flash_attn_ext {
+    using test_flash_attn_ext::test_flash_attn_ext;
+    std::string vars() override { return test_flash_attn_ext::vars() + ",kv_types=1"; }
+};
+struct test_set_kv_types : test_set_rows {
+    using test_set_rows::test_set_rows;
+    std::string vars() override { return test_set_rows::vars() + ",kv_types=1"; }
+};
+// Exact cache writes (-p kv_grid): multiples of 1/8 with a block maximum of 2 put half of the codes exactly
+// on a rounding point of the reference quantizers, and no difference is accepted.
+struct test_set_kv_grid : test_set_rows {
+    using test_set_rows::test_set_rows;
+    std::string vars() override { return test_set_rows::vars() + ",kv_grid=1"; }
+    void initialize_tensors(ggml_context * ctx) override {
+        test_set_rows::initialize_tensors(ctx);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type != GGML_TYPE_F32 || ggml_is_view_op(t->op) || t->op != GGML_OP_NONE || t->ne[1] == ne[1]) {
+                continue;
+            }
+            std::vector<float> v(ggml_nelements(t));
+            for (size_t i = 0; i < v.size(); ++i) {
+                v[i] = (float) ((int) ((i * 7) % 33) - 16) / 8.0f;
+            }
+            ggml_backend_tensor_set(t, v.data(), 0, v.size() * sizeof(float));
+        }
+    }
+    double max_nmse_err() override { return 0.0; }
+};
+
