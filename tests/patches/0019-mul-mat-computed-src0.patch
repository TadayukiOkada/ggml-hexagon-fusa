+// MUL_MAT whose src0 is computed in the graph, as in attention without flash attention
+// (keys and values are activations, not weights): src0 is a converted to type.
+struct test_mul_mat_act : public test_case {
+    const ggml_type type;
+    const int64_t m;
+    const int64_t n;
+    const int64_t k;
+    const int64_t bs;
+
+    std::string vars() override {
+        return VARS_TO_STR5(type, m, n, k, bs);
+    }
+
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+
+    uint64_t op_flops(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return 2 * m * n * k * bs;
+    }
+
+    test_mul_mat_act(ggml_type type = GGML_TYPE_F32, int64_t m = 64, int64_t n = 64, int64_t k = 128, int64_t bs = 4)
+        : type(type), m(m), n(n), k(k), bs(bs) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, m, bs);
+        ggml_tensor * b = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, n, bs);
+        ggml_set_name(a, "a");
+        ggml_set_name(b, "b");
+        ggml_tensor * a_act = ggml_cast(ctx, a, type);
+        ggml_set_name(a_act, "a_act");
+        ggml_tensor * out = ggml_mul_mat(ctx, a_act, b);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
