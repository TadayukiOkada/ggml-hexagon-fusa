+// FFN gate/up matmuls feeding a split GLU, run as one graph: backends may fuse the GLU into the matmul
+struct test_mul_mat_glu : public test_case {
+    const ggml_type type;
+    const ggml_glu_op op;
+    const int64_t k;        // model width
+    const int64_t m;        // FFN width
+    const int64_t n;        // tokens
+    const bool up_first;    // the graph computes the up matmul first
+
+    std::string vars() override { return VARS_TO_STR6(type, op, k, m, n, up_first); }
+    std::string op_desc(ggml_tensor *) override { return "MUL_MAT_GLU"; }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 5e-4; }
+
+    test_mul_mat_glu(ggml_type type, ggml_glu_op op, int64_t k, int64_t m, int64_t n, bool up_first)
+        : type(type), op(op), k(k), m(m), n(n), up_first(up_first) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * x    = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_tensor * gate = ggml_new_tensor_2d(ctx, type, k, m);
+        ggml_tensor * up   = ggml_new_tensor_2d(ctx, type, k, m);
+        ggml_set_name(x, "x");
+        ggml_set_name(gate, "gate");
+        ggml_set_name(up, "up");
+        ggml_tensor * g;
+        ggml_tensor * u;
+        if (up_first) {
+            u = ggml_mul_mat(ctx, up, x);
+            g = ggml_mul_mat(ctx, gate, x);
+        } else {
+            g = ggml_mul_mat(ctx, gate, x);
+            u = ggml_mul_mat(ctx, up, x);
+        }
+        ggml_tensor * out = ggml_glu_split(ctx, g, u, op);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
+
 // GGML_OP_OUT_PROD
 struct test_out_prod : public test_case {
     const ggml_type type_a;
