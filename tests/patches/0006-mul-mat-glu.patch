+    // FFN gate/up + GLU (fusable into the matmul): HMX row counts, a partial last chunk, both graph orders
+    for (ggml_type type : {GGML_TYPE_Q4_0, GGML_TYPE_F16, GGML_TYPE_Q8_0, GGML_TYPE_Q4_K}) {
+        for (ggml_glu_op op : {GGML_GLU_OP_GEGLU, GGML_GLU_OP_SWIGLU}) {
+            for (int64_t n : {1, 70, 512}) {
+                test_cases.emplace_back(new test_mul_mat_glu(type, op, 256, 1056, n, false));
+            }
+            test_cases.emplace_back(new test_mul_mat_glu(type, op, 512, 2048, 256, true));
+        }
+    }
+
     return test_cases;
 }
