+// final logit softcap (scale, tanh, scale) on a matmul with a few activation rows, run as one graph:
+// backends may apply it in the matmul store for the rows of a speculative verify batch
+struct test_mul_mat_softcap_rows : public test_case {
+    const ggml_type type;
+    const int64_t k;
+    const int64_t m;
+    const int64_t n;
+
+    std::string vars() override { return VARS_TO_STR4(type, k, m, n); }
+    std::string op_desc(ggml_tensor *) override { return "MUL_MAT_SOFTCAP"; }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 5e-4; }
+
+    test_mul_mat_softcap_rows(ggml_type type, int64_t k, int64_t m, int64_t n)
+        : type(type), k(k), m(m), n(n) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_tensor * w = ggml_new_tensor_2d(ctx, type, k, m);
+        ggml_set_name(x, "x");
+        ggml_set_name(w, "w");
+        ggml_tensor * out = ggml_mul_mat(ctx, w, x);
+        out = ggml_scale(ctx, out, 1.0f / 3.0f);
+        out = ggml_tanh(ctx, out);
+        out = ggml_scale(ctx, out, 3.0f);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
+
