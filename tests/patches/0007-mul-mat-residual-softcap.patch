+    for (ggml_type type : {GGML_TYPE_Q4_0, GGML_TYPE_Q8_0, GGML_TYPE_Q6_K}) {
+        for (int n_post : {1, 2, 3}) {
+            test_cases.emplace_back(new test_mul_mat_softcap(type, 512, 1056, n_post));
+        }
+        test_cases.emplace_back(new test_mul_mat_softcap(type, 1536, 32768, 3));
+    }
+
     return test_cases;
