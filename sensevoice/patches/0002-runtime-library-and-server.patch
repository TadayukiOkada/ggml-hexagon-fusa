+        else if(std::find(emotions.begin(),emotions.end(),v)!=emotions.end())emotion=v;
+        else if(v=="withitn"||v=="woitn")itn=v;
+        else if(std::find(event_names.begin(),event_names.end(),v)!=event_names.end())events.push_back(v);
+    }
