{
  "version": 4,
  "configurePresets": [
    {
      "name": "arm64-oe-linux",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm64-oe-linux.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GGML_NATIVE": "OFF",
        "GGML_OPENMP": "OFF",
        "GGML_OPENCL": "OFF",
        "LLAMA_OPENSSL": "OFF",
        "HEXAGON_SDK_ROOT": "$env{HEXAGON_SDK_ROOT}",
        "HEXAGON_TOOLS_ROOT": "$env{HEXAGON_TOOLS_ROOT}",
        "PREBUILT_LIB_DIR": "linux_aarch64"
      }
    },
    {
      "name": "arm64-oe-linux-release",
      "displayName": "ARM64 OE Linux, upstream defaults (SDK 6.x, all HTP archs)",
      "inherits": "arm64-oe-linux",
      "cacheVariables": {
        "LLAMA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "arm64-oe-linux-v73-fusa",
      "displayName": "ARM64 OE Linux, HTP v73 on FuSa firmware (skel from an older SDK, yield, SWIV)",
      "inherits": "arm64-oe-linux",
      "cacheVariables": {
        "LLAMA_BUILD_TESTS": "ON",
        "GGML_HEXAGON_FUSA": "ON",
        "GGML_HEXAGON_HTP_ARCHS": "v73",
        "GGML_HEXAGON_HTP_SDK_ROOT": "$env{HEXAGON_HTP_SDK_ROOT}",
        "GGML_HEXAGON_HTP_TOOLS_ROOT": "$env{HEXAGON_HTP_TOOLS_ROOT}",
        "GGML_HEXAGON_TOOLV": "$env{HEXAGON_HTP_TOOLV}",
        "GGML_HEXAGON_HTP_YIELD_BETWEEN_OPS": "ON",
        "GGML_HEXAGON_HTP_YIELD_IN_CPY": "ON",
        "GGML_HEXAGON_SWIV_UTILITY": "$env{SWIV_BUILD_UTILITY}",
        "GGML_HEXAGON_HTP_YIELD_IN_OPS": "ON"
      }
    },
    {
      "name": "arm64-oe-linux-v73-fusa-asr",
      "displayName": "arm64-oe-linux-v73-fusa plus NeMo-Speech.cpp speech recognition",
      "inherits": "arm64-oe-linux-v73-fusa",
      "cacheVariables": {
        "GGML_HEXAGON_ASR": "ON"
      }
    },
    {
      "name": "arm64-oe-linux-v73-fusa-sensevoice",
      "displayName": "arm64-oe-linux-v73-fusa plus SenseVoice llama.cpp speech recognition",
      "inherits": "arm64-oe-linux-v73-fusa",
      "cacheVariables": {
        "GGML_HEXAGON_SENSEVOICE": "ON"
      }
    },
    {
      "name": "arm64-android-release",
      "displayName": "ARM64 Android, upstream defaults (SDK 6.x, all HTP archs), for checking the other generations",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "GGML_NATIVE": "OFF",
        "GGML_OPENMP": "OFF",
        "GGML_OPENCL": "OFF",
        "GGML_CCACHE": "OFF",
        "LLAMA_OPENSSL": "OFF",
        "LLAMA_BUILD_TESTS": "ON",
        "HEXAGON_SDK_ROOT": "$env{HEXAGON_SDK_ROOT}",
        "HEXAGON_TOOLS_ROOT": "$env{HEXAGON_TOOLS_ROOT}",
        "PREBUILT_LIB_DIR": "android_aarch64"
      }
    },
    {
      "name": "arm64-linux-release",
      "displayName": "ARM64 Linux with clang (upstream toolchain file, all HTP archs), for the public CI container",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "toolchainFile": "${sourceDir}/llama.cpp/cmake/arm64-linux-clang.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-march=armv8.2a+fp16+dotprod",
        "CMAKE_CXX_FLAGS": "-march=armv8.2a+fp16+dotprod",
        "GGML_NATIVE": "OFF",
        "GGML_OPENMP": "OFF",
        "GGML_OPENCL": "OFF",
        "GGML_CCACHE": "OFF",
        "LLAMA_OPENSSL": "OFF",
        "LLAMA_BUILD_TESTS": "ON",
        "HEXAGON_SDK_ROOT": "$env{HEXAGON_SDK_ROOT}",
        "HEXAGON_TOOLS_ROOT": "$env{HEXAGON_TOOLS_ROOT}",
        "PREBUILT_LIB_DIR": "linux_aarch64"
      }
    }
  ]
}
