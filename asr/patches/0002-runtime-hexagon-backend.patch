+// Diagnostic boundary replacement only. Payloads are validated before use,
+// and the scheduler synchronizes the producer before this callback writes it.
+// This does not replace hidden cache state or establish a production partition.
+struct NodeReplay {
+    struct Record {
+        std::string name, op;
+        std::array<int64_t, 4> ne;
+        std::array<size_t, 4> nb;
+        std::vector<char> data;
+    };
+    struct Config {
+        std::map<size_t, Record> records;
+        std::string name, directory;
+
+        explicit Config(const std::string& directory) : directory(directory) {
+            constexpr size_t budget = 64 * 1024 * 1024;
+            size_t bytes = 0, index;
+            std::ifstream manifest(directory + "/manifest.tsv");
+            if (!manifest) throw std::runtime_error("node replay: cannot read manifest");
+            std::string line;
+            while (std::getline(manifest, line)) {
+                std::istringstream row(line);
+                std::string trailing;
+                if (!(row >> index) || (row >> trailing))
+                    throw std::runtime_error("node replay: invalid manifest row");
+                if (index >= 4096 || records.size() >= 64 || records.count(index))
+                    throw std::runtime_error("node replay: invalid/duplicate occurrence or record limit");
+                const auto base = directory + "/" + std::to_string(index);
+                std::ifstream meta(base + ".tsv");
+                Record record;
+                std::string type, extra;
+                if (!(meta >> record.name >> record.op >> type) || type != "f32")
+                    throw std::runtime_error("node replay: expected f32 metadata");
+                for (auto& v : record.ne) if (!(meta >> v) || v <= 0)
+                    throw std::runtime_error("node replay: invalid dimensions");
+                for (auto& v : record.nb) if (!(meta >> v))
+                    throw std::runtime_error("node replay: invalid strides");
+                if (meta >> extra) throw std::runtime_error("node replay: extra metadata");
+                size_t size = sizeof(float);
+                for (size_t d = 0; d < 4; ++d) {
+                    if (record.nb[d] != size || (uint64_t)record.ne[d] > budget / size)
+                        throw std::runtime_error("node replay: expected bounded contiguous tensor");
+                    size *= (size_t)record.ne[d];
+                }
+                if (size > budget - bytes) throw std::runtime_error("node replay: payload limit");
+                std::ifstream binary(base + ".bin", std::ios::binary | std::ios::ate);
+                if (!binary || binary.tellg() != (std::streamoff)size)
+                    throw std::runtime_error("node replay: payload size mismatch");
+                record.data.resize(size);
+                binary.seekg(0);
+                if (!binary.read(record.data.data(), size))
+                    throw std::runtime_error("node replay: cannot read payload");
+                for (size_t i = 0; i < size; i += sizeof(float)) {
+                    float value;
+                    std::memcpy(&value, record.data.data() + i, sizeof(value));
+                    if (!std::isfinite(value)) throw std::runtime_error("node replay: nonfinite payload");
+                }
+                if (!name.empty() && name != record.name)
+                    throw std::runtime_error("node replay: multiple boundary names");
+                name = record.name;
+                bytes += size;
+                records.emplace(index, std::move(record));
+            }
+            if (!manifest.eof() || records.empty())
+                throw std::runtime_error("node replay: invalid/empty manifest");
+        }
+
+    };
+    std::shared_ptr<const Config> config;
+    size_t occurrence = 0;
+
+    explicit NodeReplay(const std::string& directory) {
+        // One immutable bounded payload per process; counters belong to each
+        // Session. Changing the diagnostic environment after startup is invalid.
+        static const auto shared = std::make_shared<const Config>(directory);
+        if (shared->directory != directory)
+            throw std::runtime_error("node replay: directory changed after startup");
+        config = shared;
+    }
+
+    bool wants(const ggml_tensor* tensor) const { return config->name == tensor->name; }
+
+    void apply(ggml_tensor* tensor) {
+        if (occurrence >= 4096) throw std::runtime_error("node replay: occurrence limit");
+        const auto current = occurrence++;
+        auto found = config->records.find(current);
+        if (found == config->records.end()) return;
+        const auto& record = found->second;
+        if (tensor->type != GGML_TYPE_F32 || !ggml_is_contiguous(tensor) ||
+            record.op != ggml_op_name(tensor->op) || record.data.size() != ggml_nbytes(tensor))
+            throw std::runtime_error("node replay: target type/op/size mismatch");
+        for (size_t d = 0; d < 4; ++d)
+            if (tensor->ne[d] != record.ne[d] || tensor->nb[d] != record.nb[d])
+                throw std::runtime_error("node replay: target shape/stride mismatch");
+        ggml_backend_tensor_set(tensor, record.data.data(), 0, record.data.size());
+        std::fprintf(stderr, "[node-replay] name=%s occurrence=%zu bytes=%zu\n",
+                     tensor->name, current, record.data.size());
+    }
+};
+
+// Observe scheduler nodes before their storage can be reused. Opt-in only:
+// asking for every node breaks fusion/batching and is never a timing mode.
+static bool
+trace_graph_node(ggml_tensor* t, bool ask, void*) {
+    const char* dir = std::getenv("NEMO_SPEECH_NODE_TRACE_DIR");
+    if (!dir || !*dir) return ask ? false : true;
+    static const auto filter = []() -> std::unique_ptr<const std::regex> {
+        const char* value = std::getenv("NEMO_SPEECH_NODE_TRACE_REGEX");
+        return value && *value ? std::make_unique<const std::regex>(value) : nullptr;
+    }();
+    if (filter && !std::regex_search(t->name, *filter)) return ask ? false : true;
+    static std::mutex mutex;
+    static size_t count = 0, bytes = 0;
+    static bool warned_limit = false;
+    constexpr size_t max_nodes = 4096, max_bytes = 128 * 1024 * 1024;
+    std::lock_guard<std::mutex> lock(mutex);
+    const size_t size = ggml_nbytes(t);
+    if (count >= max_nodes || size > max_bytes - bytes) {
+        if (!warned_limit) {
+            std::fprintf(stderr, "[node-trace] storage limit reached; capture is incomplete\n");
+            warned_limit = true;
+        }
+        return !ask;
+    }
+    if (ask) return true;
+    const std::string base = std::string(dir) + "/" + std::to_string(count++);
+    bytes += size;
+    std::vector<char> data(size);
+    ggml_backend_tensor_get(t, data.data(), 0, size);
+    std::ofstream binary(base + ".bin", std::ios::binary);
+    std::ofstream meta(base + ".tsv");
+    binary.write(data.data(), size);
+    meta << t->name << '\t' << ggml_op_name(t->op) << '\t' << ggml_type_name(t->type);
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) meta << '\t' << t->ne[d];
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) meta << '\t' << t->nb[d];
+    meta << '\n';
+    if (!binary || !meta) throw std::runtime_error("cannot write node trace: " + base);
+    return true;
+}
+
+static bool observe_graph_node(ggml_tensor* tensor, bool ask, void* data) {
+    auto* replay = static_cast<NodeReplay*>(data);
+    const bool replace = replay && replay->wants(tensor);
+    if (ask) return trace_graph_node(tensor, true, nullptr) || replace;
+    if (replace) replay->apply(tensor);
+    return trace_graph_node(tensor, false, nullptr);
+}
