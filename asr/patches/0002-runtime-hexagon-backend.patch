+void tensor_memset(ggml_tensor* tensor, uint8_t value, size_t offset, size_t size) {
+    if (offset > ggml_nbytes(tensor) || size > ggml_nbytes(tensor) - offset)
+        throw std::out_of_range("tensor memset range");
+    // State tensors have ordinary compute storage, so partial writes preserve
+    // unclaimed slots. No model-sized temporary allocation or backend-private API.
+    std::vector<uint8_t> bytes(std::min(size, size_t(64 * 1024)), value);
+    while (size) {
+        const size_t count = std::min(size, bytes.size());
+        ggml_backend_tensor_set(tensor, bytes.data(), offset, count);
+        offset += count;
+        size -= count;
+    }
+}
