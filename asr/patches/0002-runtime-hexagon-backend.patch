+// Startup-only selector. Validate before mutating any cached run; a malformed
+// expression fails consistently, and the disabled path performs no regex work.
+static const std::regex* diagnostic_cpu_node_pattern() {
+    static const auto pattern = []() -> std::unique_ptr<const std::regex> {
+        const char* value = std::getenv("NEMO_SPEECH_CPU_NODE_REGEX");
+        return value && *value ? std::make_unique<const std::regex>(value) : nullptr;
+    }();
+    return pattern.get();
+}
