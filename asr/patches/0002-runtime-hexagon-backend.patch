+// Opt-in differential diagnostics. Read while scheduler-owned outputs are
+// still alive; this intentionally synchronizes and is unsuitable for timing.
+static void
+trace_session_outputs(TensorBag outputs) {
+    const char* dir = std::getenv("NEMO_SPEECH_OUTPUT_TRACE_DIR");
+    if (!dir || !*dir) return;
+    static std::atomic<uint64_t> sequence{0};
+    static std::atomic<size_t> bytes{0};
+    // Bound diagnostic storage even when persistent cache outputs are exposed.
+    constexpr size_t budget = 64 * 1024 * 1024;
+    const auto run = sequence.fetch_add(1);
+    for (size_t i = 0; i < outputs.tensor_count(); ++i) {
+        ggml_tensor* t = outputs.get_tensor(i).tensor;
+        if (!t) continue;
+        const char* filter = std::getenv("NEMO_SPEECH_OUTPUT_TRACE_FILTER");
+        if (filter && *filter && std::string(t->name).find(filter) == std::string::npos) continue;
+        if ((!filter || !*filter) && std::string(t->name).find("encoder.cache.") == 0) continue;
+        if (!ggml_is_contiguous(t)) continue;
+        const auto size = ggml_nbytes(t);
+        auto used = bytes.load();
+        do {
+            if (size > budget - used) {
+                fprintf(stderr, "[output-trace] storage limit reached; skipping %s\n", t->name);
+                break;
+            }
+        } while (!bytes.compare_exchange_weak(used, used + size));
+        if (size > budget - used) continue;
+        std::vector<char> data(size);
+        ggml_backend_tensor_get(t, data.data(), 0, data.size());
+        const std::string base = std::string(dir) + "/" + std::to_string(run) + "-" + std::to_string(i);
+        std::ofstream binary(base + ".bin", std::ios::binary);
+        std::ofstream meta(base + ".tsv");
+        binary.write(data.data(), data.size());
+        meta << t->name << '\t' << ggml_type_name(t->type);
+        for (int d = 0; d < GGML_MAX_DIMS; ++d) meta << '\t' << t->ne[d];
+        meta << '\n';
+        if (!binary || !meta) throw std::runtime_error("cannot write output trace: " + base);
+    }
+}
