+void TensorContainer::dump_buffer_metadata(uint64_t session, uint64_t run, const char* scope) const {
+    std::unordered_set<ggml_backend_buffer_t> seen;
+    for (const auto& owned : backend_buffers) {
+        auto buffer = owned.get();
+        if (!buffer || !seen.insert(buffer).second) continue;
+        auto type = ggml_backend_buffer_get_type(buffer);
+        auto dev = ggml_backend_buft_get_device(type);
+        auto reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+        using CountFn = size_t (*)(ggml_backend_buffer_t);
+        auto fn = reg ? reinterpret_cast<CountFn>(ggml_backend_reg_get_proc_address(
+            reg, "ggml_backend_buffer_metadata_count")) : nullptr;
+        if (!fn) continue;
+        const auto count = fn(buffer);
+        if (count == SIZE_MAX) continue;
+        fprintf(stderr, "[metadata-count] session=%llu run=%llu scope=%s buffer=%p usage=%d count=%zu\n",
+            (unsigned long long)session, (unsigned long long)run, scope, (void*)buffer,
+            int(ggml_backend_buffer_get_usage(buffer)), count);
+    }
+}
