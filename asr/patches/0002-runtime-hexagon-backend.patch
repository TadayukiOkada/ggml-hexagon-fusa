+void TensorContainer::bind_external_storage(
+    ggml_tensor* tensor, ggml_backend_buffer_t buffer, void* data) {
+    auto dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buffer));
+    auto reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    using EpochFn = uint64_t (*)(ggml_backend_buffer_t);
+    auto epoch_fn = reg ? reinterpret_cast<EpochFn>(ggml_backend_reg_get_proc_address(
+        reg, "ggml_backend_buffer_metadata_epoch")) : nullptr;
+    auto& binding = external_bindings_[tensor];
+    const uint64_t epoch = epoch_fn ? epoch_fn(buffer) : 0;
+    tensor->buffer = buffer;
+    tensor->data = data;
+    // Backends without an epoch extension (or epoch 0, untracked buffer)
+    // conservatively reinitialize aliases.
+    if (!epoch || binding.buffer != buffer || binding.epoch != epoch || !tensor->extra) {
+        tensor->extra = nullptr;
+        if (ggml_backend_buffer_init_tensor(buffer, tensor) != GGML_STATUS_SUCCESS)
+            throw std::runtime_error("cannot bind external tensor metadata");
+        binding = {buffer, epoch};
+    }
+}
