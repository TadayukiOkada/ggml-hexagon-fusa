+    Dl_info owner{};
+    if (dladdr(reinterpret_cast<void*>(&packaged_hexagon_library), &owner) && owner.dli_fname) {
+        std::error_code ec;
+        const auto path = fs::canonical(owner.dli_fname, ec);
+        if (!ec) roots.push_back(path.parent_path());
+    }
+    std::error_code ec;
+    const auto executable = fs::read_symlink("/proc/self/exe", ec);
+    if (!ec) roots.push_back(executable.parent_path());
+    for (const auto& root : roots) {
+        for (const auto& dir : {root, root.parent_path() / "lib"}) {
+            const auto candidate = dir / "libggml-hexagon.so";
+            if (fs::is_regular_file(candidate, ec) && !ec) return candidate.string();
+            ec.clear();
+        }
+    }
+#endif
+    return {};
+}
