@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <atomic>
+#include <fstream>
+#include <iomanip>
+#include <mutex>
+#include <sstream>
+
+namespace ggml_runtime {
+// Opt-in metadata diagnostics. No tensor readback or extra synchronization.
+// Buffer addresses are process-local identities, never physical addresses/FDs.
+inline void audit_string(std::ostream& out, const std::string& value) {
+    out << '"';
+    for (unsigned char c : value) {
+        switch (c) {
+            case '"': out << "\\\""; break;
+            case '\\': out << "\\\\"; break;
+            case '\n': out << "\\n"; break;
+            case '\r': out << "\\r"; break;
+            case '\t': out << "\\t"; break;
+            default:
+                if (c < 32) out << "\\u00" << std::hex << std::setw(2)
+                                << std::setfill('0') << unsigned(c) << std::dec;
+                else out << c;
+        }
+    }
+    out << '"';
+}
+inline std::string audit_identity(const void* ptr) {
+    std::ostringstream out;
+    out << ptr;
+    return out.str();
+}
+inline uint64_t audit_next_id() {
+    static std::atomic<uint64_t> id{0};
+    return ++id;
+}
+inline bool audit_enabled() {
+    const char* path = std::getenv("NEMO_SPEECH_SCHEDULE_TRACE");
+    return path && *path;
+}
+inline void audit_write(const std::string& record) {
+    const char* path = std::getenv("NEMO_SPEECH_SCHEDULE_TRACE");
+    if (!path || !*path) return;
+    static std::mutex mutex;
+    static size_t bytes = 0;
+    static bool exhausted = false;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (exhausted) return;
+    std::ofstream out(path, std::ios::app);
+    if (!out) throw std::runtime_error("cannot open schedule trace");
+    constexpr size_t budget = 128 * 1024 * 1024;
+    if (record.size() + 1 > budget - bytes) {
+        out << "{\"event\":\"truncated\",\"budget_bytes\":134217728}\n";
+        exhausted = true;
+    } else {
+        out << record << '\n';
+        bytes += record.size() + 1;
+    }
+    if (!out) throw std::runtime_error("cannot write schedule trace");
+}
+inline bool audit_metadata(const ggml_tensor* t) {
+    return t->op == GGML_OP_NONE || t->op == GGML_OP_VIEW ||
+        t->op == GGML_OP_RESHAPE || t->op == GGML_OP_PERMUTE ||
+        t->op == GGML_OP_TRANSPOSE;
+}
+inline void audit_tensor(std::ostream& out, const ggml_tensor* t) {
+    out << "{\"name\":"; audit_string(out, t->name);
+    out << ",\"dtype\":"; audit_string(out, ggml_type_name(t->type));
+    out << ",\"ne\":[";
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) out << (d ? "," : "") << t->ne[d];
+    out << "],\"nb\":[";
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) out << (d ? "," : "") << t->nb[d];
+    out << "],\"contiguous\":" << (ggml_is_contiguous(t) ? "true" : "false")
+        << ",\"permuted\":" << (ggml_is_permuted(t) ? "true" : "false")
+        << ",\"logical_bytes\":" << ggml_nbytes(t) << ",\"buffer_id\":";
+    auto buffer = t->buffer ? t->buffer : (t->view_src ? t->view_src->buffer : nullptr);
+    if (buffer) audit_string(out, audit_identity(buffer)); else out << "null";
+    out << ",\"buffer_type\":";
+    if (buffer) audit_string(out, ggml_backend_buft_name(ggml_backend_buffer_get_type(buffer)));
+    else out << "null";
+    out << ",\"usage\":";
+    if (buffer) out << int(ggml_backend_buffer_get_usage(buffer)); else out << "null";
+    out << ",\"view_source\":";
+    if (t->view_src) audit_string(out, t->view_src->name); else out << "null";
+    out << ",\"view_offset\":" << t->view_offs << '}';
+}
+// Called after scheduler allocation (source edges may refer to scheduler copies)
+// or with the known backend on a direct cache hit. These are support decisions,
+// not a claim that each logical node has its own DSP kernel or transfer.
+inline std::string audit_graph(ggml_cgraph* graph, ggml_backend_sched_t sched,
+    ggml_backend_t direct, const std::vector<ggml_backend_t>& backends,
+    const std::vector<ggml_tensor*>& cpu_nodes) {
+    std::ostringstream out;
+    out << '[';
+    const char* cpu_prefix = std::getenv("NEMO_SPEECH_CPU_WEIGHT_PREFIX");
+    for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+        auto* node = ggml_graph_node(graph, i);
+        auto selected = direct ? direct : ggml_backend_sched_get_tensor_backend(sched, node);
+        bool policy = std::find(cpu_nodes.begin(), cpu_nodes.end(), node) != cpu_nodes.end();
+        if (cpu_prefix && *cpu_prefix && node->op == GGML_OP_MUL_MAT && node->src[0] &&
+            std::string(node->src[0]->name).find(cpu_prefix) != std::string::npos) policy = true;
+        out << (i ? "," : "") << "{\"index\":" << i << ",\"op\":";
+        audit_string(out, ggml_op_name(node->op));
+        out << ",\"metadata_only\":" << (audit_metadata(node) ? "true" : "false")
+            << ",\"compute_flag\":" << ((node->flags & GGML_TENSOR_FLAG_COMPUTE) ? "true" : "false")
+            << ",\"selected_backend\":";
+        if (selected) audit_string(out, ggml_backend_name(selected)); else out << "null";
+        out << ",\"cpu_policy\":" << (policy ? "true" : "false") << ",\"output\":";
+        audit_tensor(out, node);
+        out << ",\"op_params\": [";
+        for (size_t p = 0; p < sizeof(node->op_params) / sizeof(node->op_params[0]); ++p)
+            out << (p ? "," : "") << node->op_params[p];
+        out << "],\"sources\":[";
+        bool comma = false;
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (!node->src[s]) continue;
+            auto* src = node->src[s];
+            auto sb = direct ? direct : ggml_backend_sched_get_tensor_backend(sched, src);
+            out << (comma ? "," : "") << "{\"slot\":" << s << ",\"backend\":";
+            if (sb) audit_string(out, ggml_backend_name(sb)); else out << "null";
+            out << ",\"tensor\":"; audit_tensor(out, src); out << '}';
+            comma = true;
+        }
+        out << "],\"eligibility\":[";
+        for (size_t b = 0; b < backends.size(); ++b) {
